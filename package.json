{
  "name": "artifact-viewer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "node server/index.js",
    "assets:pull": "node scripts/pull-models.mjs",
    "assets:check": "node scripts/check-assets.mjs",
    "smoke:api": "node scripts/smoke-api.mjs",
    "smoke:kiosk": "node scripts/smoke-kiosk.mjs",
    "test": "node --test",
    "build": "npm run assets:check && vite build",
    "preview": "vite preview",
    "preview:full": "node scripts/preview-full-stack.mjs"
  },
  "dependencies": {
    "three": "^0.181.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "playwright-core": "^1.58.2",
    "vite": "^7.1.10"
  }
}
